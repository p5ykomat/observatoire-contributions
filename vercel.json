{
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": { "api/index.py": { "maxDuration": 60, "includeFiles": "{backend,config}/**", "excludeFiles": "{.venv,frontend/node_modules,tests,output}/**" } },
  "rewrites": [ { "source": "/api/:path*", "destination": "/api/index" }, { "source": "/((?!assets/).*)", "destination": "/index.html" } ],
  "headers": [{ "source": "/(.*)", "headers": [{ "key": "Referrer-Policy", "value": "no-referrer" }, { "key": "X-Content-Type-Options", "value": "nosniff" }] }]
}
